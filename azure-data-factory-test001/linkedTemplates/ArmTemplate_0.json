					{
						"name": "prepare logic apps body",
						"type": "SetVariable",
						"dependsOn": [
							{
								"activity": "prepare email subject",
								"dependencyConditions": [
									"Succeeded"
								]
							},
							{
								"activity": "prepareEmail body",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"variableName": "logic apps body",
							"value": {
								"value": "{\"email_recepient\": \"@{pipeline().parameters.email_recepient}\",\n\"subject\": \"@{variables('email subject')}\",\n\"boddy\" : \"@{variables('email body')}\"\n}",
								"type": "Expression"
