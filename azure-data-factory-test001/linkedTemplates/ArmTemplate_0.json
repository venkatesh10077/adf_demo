						}
					},
					{
						"name": "prepare email subject",
						"type": "SetVariable",
						"dependsOn": [],
						"policy": {
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"variableName": "email subject",
							"value": {
								"value": "@{pipeline().parameters.table_name} - @{pipeline().parameters.status}",
								"type": "Expression"
							}
						}
					},
					{
						"name": "prepareEmail body",
						"type": "SetVariable",
						"dependsOn": [],
						"policy": {
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"variableName": "email body",
							"value": {
								"value": "the table @{pipeline().parameters.table_name} has been ingestion completed. and status is  @{pipeline().parameters.status}",
								"type": "Expression"
							}
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"parameters": {
					"table_name": {
						"type": "string"
					},
					"status": {
						"type": "string"
					},
					"email_recepient": {
						"type": "string",
						"defaultValue": "venkychillakuru@gmail.com"
					}
				},
				"variables": {
					"logic apps body": {
						"type": "String"
					},
					"email subject": {
						"type": "String"
					},
					"email body": {
						"type": "String"
					}
				},
				"annotations": [],
				"lastPublishTime": "2026-10-28T05:11:11Z"
			},
			"dependsOn": []
