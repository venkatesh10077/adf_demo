{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "azure-data-factory-test001"
		},
		"testdemo_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'testdemo'"
		},
		"ls_adls_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://venkyadfstorage2026.dfs.core.windows.net/"
		},
		"testdemo_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "venky-adf-sql-2026.database.windows.net"
		},
		"testdemo_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "adf_practice_db"
		},
		"testdemo_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "venkyadmin"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "azure-data-factory-test001_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"testdemo_password": {
						"value": "[parameters('testdemo_password')]"
					},
					"ls_adls_properties_typeProperties_url": {
						"value": "[parameters('ls_adls_properties_typeProperties_url')]"
					},
					"testdemo_properties_typeProperties_server": {
						"value": "[parameters('testdemo_properties_typeProperties_server')]"
					},
					"testdemo_properties_typeProperties_database": {
						"value": "[parameters('testdemo_properties_typeProperties_database')]"
					},
					"testdemo_properties_typeProperties_userName": {
						"value": "[parameters('testdemo_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}