{
	"name": "pl_foreach_demo",
	"properties": {
		"activities": [
			{
				"name": "ingest all data",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "read list of tables",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('read list of tables').output.value",
						"type": "Expression"
					},
					"isSequential": false,
					"activities": [
						{
							"name": "Execute ingestion Pipeline",
							"type": "ExecutePipeline",
							"dependsOn": [],
							"policy": {
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "pl_demo_ingestion",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true,
								"parameters": {
									"table_name": {
										"value": "@item().table_name",
										"type": "Expression"
									}
								}
							}
						},
						{
							"name": "store_tables_success",
							"type": "AppendVariable",
							"dependsOn": [
								{
									"activity": "Execute ingestion Pipeline",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"variableName": "table_status",
								"value": {
									"value": "@{item().table_name} - Success",
									"type": "Expression"
								}
							}
						},
						{
							"name": "store_tables_failure",
							"type": "AppendVariable",
							"dependsOn": [
								{
									"activity": "Execute ingestion Pipeline",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"variableName": "table_status",
								"value": {
									"value": "@{item().table_name} - Failure",
									"type": "Expression"
								}
							}
						}
					]
				}
			},
			{
				"name": "read list of tables",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "select table_name from metadata.table_list",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "dstest",
						"type": "DatasetReference",
						"parameters": {
							"schema": "dbo",
							"table_name": "customers"
						}
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "send consolidated email",
				"type": "ExecutePipeline",
				"dependsOn": [
					{
						"activity": "ingest all data",
						"dependencyConditions": [
							"Completed"
						]
					}
				],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "pl_email_demo_multiple",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true,
					"parameters": {
						"email_recepient": {
							"value": "@pipeline().globalParameters.email_recepients",
							"type": "Expression"
						},
						"table_status": {
							"value": "@variables('table_status')",
							"type": "Expression"
						}
					}
				}
			}
		],
		"variables": {
			"table_status": {
				"type": "Array"
			}
		},
		"annotations": [],
		"lastPublishTime": "2026-10-28T06:44:10Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}